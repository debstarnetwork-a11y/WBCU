# ==============================================================================
# WB CREDIT UNION (www.wbcu.net) - CPANEL PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=production
PORT=3000
APP_NAME="WB Credit Union"
APP_URL=https://wbcu.net
APP_DOMAIN=wbcu.net

# AI Live Support (Google Gemini API)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# cPanel MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glolbka_wbcu_db
DB_USER=glolbka_wbcu_user
DB_PASSWORD=YOUR_CPANEL_DATABASE_PASSWORD_HERE

# Security Keys & JWT Secrets
JWT_SECRET=wbcu_live_jwt_secure_key_9f8e7d6c5b4a3210
SESSION_SECRET=wbcu_session_encryption_secret_key_87654321
ADMIN_SECURITY_PIN=9988

# Support & System Contact Details
SUPPORT_EMAIL=support@wbcu.net
INFO_EMAIL=info@wbcu.net
SUPPORT_PHONE="1-800-BANKING"
BANK_ADDRESS="109, Feldgüetliweg Meilen Bezirk Meilen Zurich 8706 Switzerland"

# cPanel SMTP Mail Gateway Settings (for Transaction & COT/TAX Notifications)
SMTP_HOST=mail.wbcu.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@wbcu.net
SMTP_PASS=YOUR_CPANEL_WEBMAIL_PASSWORD_HERE
SMTP_SENDER_EMAIL=info@wbcu.net
SMTP_SENDER_NAME="WB Credit Union"

# Optional Client Environment Overrides (Vite Prefix)
VITE_APP_TITLE="WB Credit Union | Swiss Depository & Institutional Wealth Management"
VITE_API_BASE_URL=https://wbcu.net
