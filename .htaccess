# ==============================================================================
# WB CREDIT FINANCE - PRODUCTION APACHE CONFIGURATION
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS & Standardize Domain (Non-WWW)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.wbcu\.net$ [NC]
  RewriteRule ^(.*)$ https://wbcu.net/$1 [L,R=301]

  # 2. Admin Portal URL Rewrites
  RewriteRule ^pages/admin/?$ pages/admin/index.html [L,QSA]
  RewriteRule ^admin/?$ admin/index.html [L,QSA]
  RewriteRule ^pages/admin-dashboard/?$ pages/admin-dashboard.html [L,QSA]
  RewriteRule ^pages/admin-login/?$ pages/admin-login.html [L,QSA]
  RewriteRule ^admin-login/?$ pages/admin-login.html [L,QSA]
  RewriteRule ^login-admin/?$ pages/admin-login.html [L,QSA]

  # 3. Admin API Endpoints (Strict No-Redirect for POST)
  RewriteRule ^api/admin/login$ api/admin-login.php [L,QSA]
  RewriteRule ^api/admin/login/$ api/admin-login.php [L,QSA]
  RewriteRule ^api/admin-login\.php$ api/admin-login.php [L,QSA]
  
  RewriteRule ^api/admin/users$ api/admin-users.php [L,QSA]
  RewriteRule ^api/admin/users/$ api/admin-users.php [L,QSA]
  
  RewriteRule ^api/users$ api/users.php [L,QSA]
  RewriteRule ^api/users/$ api/users.php [L,QSA]

  # 4. SPA Fallback (Optional, but useful)
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule . index.html [L]
</IfModule>

# Security Headers & Anti-Caching for Instant Live Site Updates
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  <FilesMatch "\.(html|htm|js|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Disable Directory Browsing
Options -Indexes

