# ==============================================================================
# WB CREDIT FINANCE - RESTORED PRODUCTION CONFIGURATION
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Map root requests to correct files in pages/ if they exist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^login$ pages/login.html [L,QSA]
  
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^register$ pages/register.html [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^dashboard$ pages/dashboard.html [L,QSA]

  # 3. Admin Routing
  RewriteRule ^admin-login$ pages/admin-login.html [L,QSA]
  RewriteRule ^admin$ pages/admin-dashboard.html [L,QSA]

  # 4. API Forwarding (Harden to avoid POST loss)
  # Ensure we point to the actual PHP files directly
  RewriteRule ^api/login$ api/login.php [L,QSA]
  RewriteRule ^api/admin-login.php$ api/login.php [L,QSA]
  RewriteRule ^api/admin/users$ api/admin-users.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html|htm|js|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

Options -Indexes
