# ==============================================================================
# WB CREDIT FINANCE - PRODUCTION APACHE CONFIGURATION (V3 - PATH FIXED)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS & Standardize Domain (Non-WWW)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.wbcu\.net$ [NC]
  RewriteRule ^(.*)$ https://wbcu.net/$1 [L,R=301]

  # 2. Redirect folders to files (Fixes relative asset path issue)
  RewriteRule ^admin/?$ admin.html [L,QSA]
  RewriteRule ^admin-login/?$ admin-login.html [L,QSA]
  RewriteRule ^login-admin/?$ admin-login.html [L,QSA]
  RewriteRule ^pages/admin-login/?$ admin-login.html [L,QSA]
  RewriteRule ^pages/admin-dashboard/?$ admin.html [L,QSA]
  RewriteRule ^pages/admin/?$ admin.html [L,QSA]

  # 3. Unified Authentication Engine (Prevents POST loss)
  RewriteRule ^api/admin/login$ api/login.php [L,QSA]
  RewriteRule ^api/admin/users$ api/admin-users.php [L,QSA]
  RewriteRule ^api/users$ api/login.php [L,QSA]
  RewriteRule ^api/login$ api/login.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html|htm|js|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

Options -Indexes
